# Epic BOS server — environment
PORT=3001
HOST=0.0.0.0

# Single-tenant Phase-0: the acting org/company + user (RBAC stub)
EPIC_TENANT=T1
EPIC_USER=admin@epic.local
EPIC_API_KEY=dev-key-change-me

# Persistence: JSON snapshot file (no external DB required for Phase 0)
EPIC_DATA_FILE=./data/epic.json

# shortlinXchat (WhatsAPI) — founder's free WhatsApp integration
SHOTLINXCHAT_URL=http://localhost:3000
SHOTLINXCHAT_API_KEY=epic-wa-key
SHOTLINXCHAT_RATE_LIMIT=15
# Where WhatsAPI should PUSH inbound messages (set after server boots):
# SHOTLINXCHAT_WEBHOOK_URL=http://localhost:3001/api/wa/inbound

# Public base used to build links sent over WhatsApp (UPI/Razorpay etc.)
EPIC_PUBLIC_BASE=http://localhost:3001

# GST supplier (your company) — drives CGST/SGST vs IGST split (docs/05-india-compliance/01-gst.md)
EPIC_SUPPLIER_STATE=29            # Karnataka (2-digit GST state code)
EPIC_SUPPLIER_GSTIN=29ABCDE1234F1Z5
EPIC_COMPANY_NAME=Epic BOS Demo Pvt Ltd
EPIC_COMPANY_ADDR=No. 1, MG Road, Bengaluru
GST_EINVOICE_THRESHOLD=5000000    # ₹5 Cr turnover -> e-invoicing mandatory (A3 sentinel)

# GSP / IRP integration (e-invoice IRN, e-way bill, IMS 2A/2B).
# Phase 0 runs on the deterministic sandbox (GSP_PROVIDER=sandbox, no creds).
# Go live: set GSP_PROVIDER=rest and supply the credentials from your GSP/NIC sandbox.
GSP_PROVIDER=sandbox
# GSP_BASE_URL=https://einvoice1.gst.gov.in
# GSP_AUTH_TOKEN=
# GSP_ID=
